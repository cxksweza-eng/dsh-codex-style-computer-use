  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "homepage": "https://github.com/ltmroberthk915/dsh-computer-use#readme",
  "bugs": {
    "url": "https://github.com/ltmroberthk915/dsh-computer-use/issues"
  }
